# Every environment variable the web app reads, with no values. Copy this file
# to .env.local for development and fill in what you need; a deployment sets
# the same names in the Vercel project's settings. Server code reads them
# through src/lib/env.ts. A line left commented out is optional and has a
# default; leave it unset rather than empty.

# Postgres connection string. Required. It carries `options=-c%20search_path%3Dirun`, not the
# `search_path=irun` db/.env uses: node-postgres drops parameters it does not know.
DATABASE_URL=

# Better Auth's signing secret; Better Auth reads it itself.
BETTER_AUTH_SECRET=
# This deployment's own origin, e.g. http://localhost:3000; also starts the links in mail.
BETTER_AUTH_URL=
# Where the browser's auth client posts; the same origin as BETTER_AUTH_URL.
NEXT_PUBLIC_APP_URL=
# Which deployment this is: DEV, TEST, STAGING or PRODUCTION. The build stops without it.
NEXT_PUBLIC_ENVIRONMENT=
# NEXT_PUBLIC_BUILT_AT is stamped by next.config.ts at build time; never set it.

# Google sign-in's OAuth client. Optional: without them only email sign-in works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel Blob store token for image uploads; @vercel/blob reads it itself.
BLOB_READ_WRITE_TOKEN=

# Bearer token Vercel's scheduler sends to the cron routes; unset, they refuse every request.
CRON_SECRET=

# Resend API key; unset, mail is logged and not sent.
RESEND_API_KEY=
# Sender address; defaults to "Storyteller <noreply@storyteller.irun.games>".
# EMAIL_FROM=
# Where mail goes in every environment but production; unset there, nothing is sent.
EMAIL_NON_PRODUCTION_TO=

# EMQX broker host name, without scheme or port; unset, the table works without live updates.
MQTT_ADDRESS=
# The broker's REST API port, for the server's publishes; defaults to 8443.
# MQTT_API_PORT=
# The broker's WebSocket TLS port, for the players' browsers; defaults to 8084.
# MQTT_WS_TLS_PORT=
# The app's EMQX API key and secret, for publishing from the server.
MQTT_APP_ID=
MQTT_APP_SECRET=
# The shared subscribe-only login handed to players' browsers.
MQTT_PLAYER_USERNAME=
MQTT_PLAYER_PASSWORD=

# Time zone of the server process. Leave unset: Vercel runs in UTC, and the tests pin UTC themselves.
# TZ=
